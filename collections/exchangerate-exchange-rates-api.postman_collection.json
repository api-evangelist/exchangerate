    "_postman_id": "0db8cf87-7d2d-49a2-9e81-740a3f4f3c75",
    "name": "ExchangeRate Account Exchange Rates API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "ExchangeRate-API provides real-time and historical currency exchange rates for 165 currencies across 200 countries. Operating since 2010, the service delivers reliable currency conversion data via simple HTTP GET requests. Authentication is supported via API key embedded in the URL path or via Bearer token header. A free tier is available with 1,500 monthly requests and daily updates; paid plans offer hourly or 5-minute update frequencies and higher quotas. Historical data is available back to 1990.\n\n\nContact Support:\n Name: ExchangeRate-API Support\n Email: support@exchangerate-api.com",
      "type": "text/plain"
    }
  }
