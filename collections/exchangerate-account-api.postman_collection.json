                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "apiKey",
                  "description": "(Required) Your personal API key obtained from the ExchangeRate-API dashboard"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "noauth"
            }
