{
  "opencollection": "1.0.0",
  "info": {
    "name": "ExchangeRate Account API",
    "version": "6"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get API request quota information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://v6.exchangerate-api.com/v6/:apiKey/quota",
            "params": [
              {
                "name": "apiKey",
                "value": "",
                "type": "path",
                "description": "Your personal API key obtained from the ExchangeRate-API dashboard"
              }
            ]
          },
          "docs": "Returns the remaining request quota for the current billing period along with plan details.\n"
        }
      ]
    }
  ],
  "bundled": true
}